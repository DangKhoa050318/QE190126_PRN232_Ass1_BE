# PostgreSQL connection. Render provides a URL like postgres://user:pass@host:port/db;
# a key=value Npgsql connection string also works.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/TaskManagementDB

# Development locally, Production on Render
ASPNETCORE_ENVIRONMENT=Production

# Secret used to sign JWTs (at least 32 random characters). Required in production;
# locally appsettings.Development.json provides a development-only value.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Origins allowed by CORS (comma-separated), e.g. the Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app

# The frontend (separate repo) needs the URL of this API
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
